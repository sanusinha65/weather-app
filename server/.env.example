# OpenWeather API key (https://openweathermap.org/api). Required.
WEATHER_API_KEY=your_openweather_api_key_here

# Port the backend listens on. Optional, defaults to 5000.
PORT=5000

# Comma-separated list of allowed origins for CORS. Optional.
# Defaults to http://localhost:3000 (the CRA dev server).
CORS_ORIGIN=http://localhost:3000

# How long (in seconds) upstream responses are cached in memory. Optional.
CACHE_TTL_SECONDS=300
